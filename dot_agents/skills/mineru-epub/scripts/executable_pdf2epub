#!/usr/bin/env bash
# Launcher: run convert.py with the skill venv.
set -euo pipefail
ROOT="${MINERU_SKILL_HOME:-$HOME/.local/share/mineru-skill}"
VENV="${MINERU_VENV:-$ROOT/venv}"
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
if [ ! -x "$VENV/bin/python" ]; then
  echo "venv missing: $VENV — run $HERE/setup.sh first" >&2
  exit 1
fi
exec "$VENV/bin/python" "$HERE/convert.py" "$@"
